# Adinkra/query server instance — port 8002
[Unit]
Description=UJAMAA query server (8002)
After=network-online.target
[Service]
User=paperspace
WorkingDirectory=/home/paperspace/code/ujamaa/adinkra
ExecStart=/usr/bin/python3 -m uvicorn server:app --host 127.0.0.1 --port 8002
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
